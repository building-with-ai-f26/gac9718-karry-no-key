# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# ACRCloud (Karry-No-Key laptop app) — from console.acrcloud.com → your project
ACR_HOST=identify-us-west-2.acrcloud.com
ACR_ACCESS_KEY=replace-with-your-access-key
ACR_ACCESS_SECRET=replace-with-your-access-secret

# Spotify (save songs to your "Sung It" playlist) — from developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=replace-with-your-client-id
SPOTIFY_CLIENT_SECRET=replace-with-your-client-secret

# Find my Karry-No-Key: shared secret with the watch (same value as WATCH_KEY in the watch's secrets.h)
WATCH_KEY=replace-with-a-long-random-key
