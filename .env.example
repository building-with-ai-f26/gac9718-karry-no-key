# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# ACRCloud (Karry-No-Key laptop app) — from console.acrcloud.com → your project
ACR_HOST=identify-us-west-2.acrcloud.com
ACR_ACCESS_KEY=replace-with-your-access-key
ACR_ACCESS_SECRET=replace-with-your-access-secret
